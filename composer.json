{
  "name": "anderson-scherdovski/base",
  "description": "A base",
  "license": "MIT",
  "keywords": [
    "base"
  ],
  "type": "library",
  "authors": [
    {
      "name": "Anderson Scherdovski",
      "email": "aandersonscherdovski@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/filesystem": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.3",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "AndersonScherdovski\\Base\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndersonScherdovski\\Base\\Tests\\": "tests"
    }
  },
  "scripts": {
    "phpunit": "phpunit",
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "AndersonScherdovski\\Base\\ServiceProvider"
      ]
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
